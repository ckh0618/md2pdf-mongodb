    "@napi-rs/canvas": "^0.1.100",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.52.0",
    "pretendard": "^1.3.9",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
