{
  "name": "@md2pdf/renderer",
  "version": "0.3.0",
  "description": "Markdown to self-contained HTML and PDF renderer",
  "type": "module",
  "bin": {
    "md-to-pdf": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
